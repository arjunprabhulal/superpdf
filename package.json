{
  "name": "@superpdf/cli",
  "version": "0.3.0",
  "description": "superPDF AI on your computer: PDF tools for Terminal, scripts and AI agents (command-line tool, MCP server and local API)",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "superpdf": "bin/superpdf.js"
  },
  "exports": {
    "./core": "./lib/pdf-core.js"
  },
  "files": [
    "bin",
    "lib",
    "mcp",
    "api",
    "contracts",
    "openapi.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "openapi": "node scripts/openapi.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@neslinesli93/qpdf-wasm": "0.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "docx": "9.10.0",
    "fflate": "0.8.3",
    "marked": "18.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "4.0.1",
    "tesseract.js": "7.0.0",
    "write-excel-file": "4.1.1",
    "zod": "4.6.6"
  },
  "homepage": "https://superpdf.ai/docs/mcp-api/command-line-tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arjunprabhulal/superpdf.git"
  },
  "bugs": {
    "url": "https://github.com/arjunprabhulal/superpdf/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "zod-openapi": "6.0.2"
  },
  "author": {
    "name": "Arjun Prabhulal",
    "url": "https://arjunprabhulal.com"
  }
}
